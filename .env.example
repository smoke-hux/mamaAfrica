# Copy to .env for local development, or set these with `vercel env add` for a deployment.
# Nothing here is required: without it the app runs with a simplified fallback map and the
# dispatch board is disabled (locally it falls back to the dev token below).

# --- Google Maps -------------------------------------------------------------
# Browser key. This one is SHIPPED TO THE BROWSER, so restrict it in Google Cloud Console to
# HTTP referrers (your domains) and to the "Maps JavaScript API" only. Without it the tracking
# map falls back to a self-drawn simplified map.
GOOGLE_MAPS_BROWSER_KEY=

# Optional Map ID for Google's cloud-based map styling. When set, the app uses Advanced Markers
# and Google's hosted style instead of the inline style array.
GOOGLE_MAPS_MAP_ID=

# --- Dispatch board ----------------------------------------------------------
# Shared secret for /dispatch.html and GET /api/dispatch/orders, which expose customer names,
# phone numbers and delivery areas. Unset on Vercel means the endpoint returns 503 (fails closed).
# Locally it defaults to `dev-dispatch-token`. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DISPATCH_TOKEN=

# --- Misc --------------------------------------------------------------------
# Lets the tracking API accept `?at=<ISO>` to simulate a moment in time. Tests and demos only:
# never enable this in production, it lets anyone ask the server to claim an order was delivered.
TRACKING_TIME_TRAVEL=

# Set to `off` to disable the per-IP rate limiter (used by the test suites).
RATE_LIMIT=

# Trust `x-real-ip` for rate limiting when running behind your own proxy (Vercel sets this itself).
TRUST_PROXY=
